#!/usr/bin/env bash
# mitsuishi-dev SessionStart フック（タイムアウト 30 秒。常に exit 0）
#   1. 既定（社内の決まりは無効）は案内 3 行（/mitsuishi-dev:workflow で有効にできること・CLAUDE.md にあっても宣言が無ければ無効）と
#      gstack の状態 1 行だけを注入する。社内の決まりが有効（lib/common.sh の is_full: 宣言の印 full/<session_id> がある、
#      または MITSUISHI_DEFAULT=full で外す印が無い）なら、全文（フルで回す旨・案内・SKILL.md・MODELS.md）と gstack の状態 1 行を注入する
#      印は session_id 単位。compact では session_id が変わらず続く。/clear・resume で変われば引き継がれない（変わるかは未確認）
#      利用者の画面に出す 1 行（systemMessage）: gstack が失敗・注意の状態のとき、compact・clear で有効のまま注入し直したとき（2 つなら改行でつなぐ）
#   2. どのフォルダで始めても（git があれば）、gstack の導入・毎日の更新を裏で始める（hooks/lib/gstack-bg.sh。待たない）
#   注入文には止め方（環境変数の名前と値）を書かない（AI が自分でガードを外さないため。止め方は人向けの README だけ）
# 停止: MITSUISHI_HOOKS_OFF（1・all・session-start。0・false・no・off・none は止めない。未知の値は全部止める）

if [ -n "${MITSUISHI_HOOKS_OFF:-}" ]; then
  _off=$(printf '%s' "$MITSUISHI_HOOKS_OFF" | tr 'A-Z' 'a-z' | tr -d ' \t\r\n')
  set -f; IFS=,
  for _t in $_off; do
    case "$_t" in ''|0|false|no|off|none|planner-edit|subagent|skill-reminder) ;; *) exit 0 ;; esac
  done
  unset IFS; set +f
fi

set +e
HOOK=session-start
_self="${0//\\//}"
case "$_self" in */*) HOOK_DIR="${_self%/*}" ;; *) HOOK_DIR=. ;; esac
. "$HOOK_DIR/lib/common.sh" 2>/dev/null || {
  cat >/dev/null 2>&1
  mkdir -p "$HOME/.claude/mitsuishi-dev" 2>/dev/null
  printf '%s\t%s\t%s\t-\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$HOOK" MITSUISHI-FAIL-LIB "lib/common.sh を読めない" >>"$HOME/.claude/mitsuishi-dev/hooks.log" 2>/dev/null
  exit 0
}
read_input
CWD="$J_CWD"
[ -n "$CWD" ] || CWD="$PWD"

# ── gstack の状態（と裏の導入・更新） ──
BG="$HOOK_DIR/lib/gstack-bg.sh"
BG_ACTION=none; BG_STATUS=""
if . "$BG" 2>/dev/null; then
  bg_status </dev/null 2>/dev/null
fi
STATUS="$BG_STATUS"
[ -n "$STATUS" ] || STATUS="【注意】gstack の状態を確かめられなかった（ログ: $MITSUISHI_STATE_DIR/gstack.log）。"
if [ "$BG_ACTION" = "run" ]; then
  # setsid があれば別のセッションで起動する（セッションの終了で裏の処理が巻き込まれて止まらないため）
  if command -v setsid >/dev/null 2>&1; then
    ( setsid bash "$BG" run ) </dev/null >/dev/null 2>&1 &
  else
    ( bash "$BG" run ) </dev/null >/dev/null 2>&1 &
  fi
fi

# ── 注入 ──
# 既定（無効）は社内の決まりを注入せず、案内と gstack の状態だけ。有効なら（compact の後も）全文と gstack の状態
FULL=0
if is_full; then
  FULL=1
  rules_context
  CONTEXT="${RULES_CTX}

## gstack の状態（このセッション開始時）
${STATUS}
</mitsuishi-dev>"
else
  if [ "$DEFAULT_FULL" = 1 ]; then
    _first="このセッションでは社内の決まり（mitsuishi-dev）を外している。また使うときは /mitsuishi-dev:workflow。"
  else
    _first="社内の決まり（mitsuishi-dev）は既定で無効。使うときは /mitsuishi-dev:workflow（他に同名のスキルが無ければ /workflow でも可）。
CLAUDE.md などに社内の決まり（mitsuishi-dev）に従うとあっても、宣言が無ければ既定（無効）で進める。"
  fi
  CONTEXT="<mitsuishi-dev>
${_first}
フックに止められたら回避しない。止める必要があると思ったら、自分で止めずに利用者に相談する（開発者でなければ管理者に相談）。

## gstack の状態（このセッション開始時）
${STATUS}
</mitsuishi-dev>"
fi

# 制御文字を落とす（改行・タブは残す）
strip_ctrl "$CONTEXT"; CONTEXT="$REPLY"

# 失敗・注意のときだけ、利用者の画面に 1 行（systemMessage）を出す。正常・導入中は出さない
USER_MSG=""
case "$STATUS" in
  *"git なし"*) USER_MSG="Git が見つからないため、mitsuishi-dev の編集ガードと gstack が動いていません。Git を入れて起動し直してください。" ;;
  【注意】*|*"前回の導入に失敗"*|*"前回の更新に失敗"*)
    USER_MSG="gstack の導入・更新に失敗しています。ログ: ${GSTACK_LOG:-$MITSUISHI_STATE_DIR/gstack.log}" ;;
esac
# 有効のまま compact・clear で注入し直したときは、その状態も 1 行（gstack の 1 行と同時なら改行でつなぐ）
if [ "$FULL" = 1 ]; then
  case "$J_SOURCE" in
    compact|clear) USER_MSG="社内の決まり: 有効（/mitsuishi-dev:light で戻す）${USER_MSG:+
$USER_MSG}" ;;
  esac
fi
SYS_LINE=""
if [ -n "$USER_MSG" ]; then
  json_escape "$USER_MSG"
  SYS_LINE="  \"systemMessage\": \"$REPLY\","$'\n'
fi

json_escape "$CONTEXT"
printf '{\n%s  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$SYS_LINE" "$REPLY"

exit 0
