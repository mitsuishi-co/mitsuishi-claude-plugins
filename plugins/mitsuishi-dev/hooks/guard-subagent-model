#!/usr/bin/env bash
# PreToolUse（Agent / Task）
# Fable（および Mythos 系）はプランナー専用。実行役のサブエージェントに指定させない。

INPUT=$(cat)
MODEL=$(printf '%s' "$INPUT" | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)

case "$(printf '%s' "$MODEL" | tr 'A-Z' 'a-z')" in
  *fable*|*mythos*)
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"社内ルール：Fable はプランナー専用です。実行役のサブエージェントには opus・sonnet・haiku のいずれかを指定してください（指定なしの場合は既定の実行役モデルになります）。"}}\n' ;;
esac
exit 0
